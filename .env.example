# ──────────────────────────────────────────────────────────────
#  Privy AI Starter — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Supabase (required) ────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# ── Privy AI (required for Privy AI mode) ─────────────────────
# 1. Register your app: POST https://privyai.ch/api/platform/apps
#    Body: { "name": "My App", "persona": "You are..." }
#    → Save the returned appKey below.
# Use promo code HACKATHON2026 for free trial access.
PRIVY_APP_KEY=your_privy_app_key_here

# ── Lovable AI gateway (required for Gemini mode) ─────────────
# Get from your Lovable project settings → Integrations → API key
LOVABLE_API_KEY=your_lovable_api_key_here
